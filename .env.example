# Story Pattern Lab environment

APP_NAME=Story Pattern Lab
APP_ENV=local
API_HOST=0.0.0.0
API_PORT=8000

DATABASE_URL=postgresql+psycopg://storylab:storylab@localhost:5432/storylab
REDIS_URL=redis://localhost:6379/0

# Optional. Use when enabling LLM generation.
LLM_PROVIDER=openai
OPENAI_API_KEY=
LLM_MODEL=gpt-5.5-thinking

# Collector defaults
COLLECTOR_USER_AGENT=StoryPatternLabBot/0.1 contact@example.com
DEFAULT_CRAWL_INTERVAL_MINUTES=60
AI_ANALYSIS_MIN_VIRAL_SCORE=70
AI_ANALYSIS_DAILY_LIMIT=100
